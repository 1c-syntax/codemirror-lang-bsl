// Lezer grammar for the BSL Query Language (SDBL / Язык запросов 1С).
//
// SDBL is consumed only as embedded content inside BSL string literals
// (highlighted via parseMixed). The grammar's job is therefore *tokenization
// + classification* rather than full structural parsing: each token routes
// to the right @lezer/highlight tag, but no statement structure is enforced
// (this keeps the grammar tolerant of fragments inside arbitrary string
// content — including dynamic concatenations, partial queries built up over
// several assignments, etc.).
//
// Token vocabulary mirrors https://github.com/1c-syntax/bsl-parser
// (`SDBLLexer.g4`). Case-insensitive matching uses the same @external
// specialize machinery as the BSL grammar — Russian and English forms share
// each entry.

@top Query {
  fragment*
}

fragment {
  StmtKw |
  OpKw |
  FuncKw |
  TypeKw |
  MdoRef |
  FieldKw |
  BoolLit |
  NullLit |
  UndefinedLit |
  Parameter |
  Identifier |
  Number |
  StringLit |
  ParenGroup |
  BraceGroup |
  AddOp |
  MulOp |
  CmpOp |
  Punct
}

// Metadata-object reference path: `Справочник.Контрагенты`,
// `РегистрНакопления.ТоварыНаСкладах.Остатки`, etc. Only inside this
// structure do the trailing identifier components mean "table name" and
// "virtual table" — at the lexer level we keep them as plain Identifier
// so they don't get the namespace/class colour in other positions
// (e.g. an alias `Остатки` defined via `КАК Остатки`).
//
// `!mdoTail` biases the parser to shift each `Dot Identifier` into the
// current MdoRef rather than reduce early (which would leak the dot into
// a sibling Punct(Dot) and split the path).
MdoRef { MdoKw (!mdoTail Dot Identifier)* }

ParenGroup { LParen fragment* RParen }

// `{...}` blocks in SDBL carry data-composition-system parameters that the
// 1C query engine consumes out-of-band; ANTLR routes their contents to a
// hidden channel. For highlighting purposes we let them sit as a nested
// group so the surrounding query keeps parsing cleanly and styleTags can
// pick the whole group out as configuration metadata.
BraceGroup { LBrace fragment* RBrace }

// Parameter name accepts any identifier-shaped token, including ones that
// the @external specialize hook turns into category keywords (the most
// common case is `&НачалоПериода` where `началопериода` matches the
// BEGINOFPERIOD function name in the SDBL keyword table). Without this the
// parser produces an error token where the keyword sits and the parameter
// stops being recognised.
Parameter { Ampersand sdblName }
sdblName {
  Identifier | StmtKw | OpKw | FuncKw | TypeKw | MdoKw | FieldKw |
  BoolLit | NullLit | UndefinedLit
}

AddOp { Plus | Minus }
MulOp { Mul | Quotient }
CmpOp { Assign | NotEqual | Less | LessOrEqual | Greater | GreaterOrEqual }
Punct { Comma | Semicolon | Colon | Dot | Hash }

// ---- Skipping ----

@precedence {
  // Used by MdoRef to prefer extending the path with another `Dot
  // Identifier` over reducing the MdoRef early.
  mdoTail @left
}

@skip { space | LineComment }

// ---- Tokens ----

@tokens {
  space { @whitespace+ }

  LineComment { "//" ![\n]* }

  // Identifier — Latin + Cyrillic + underscore + alphanumeric.
  identifierChar { $[a-zA-Z_Ѐ-ӿԀ-ԯ] }
  identifierContinue { $[a-zA-Z0-9_Ѐ-ӿԀ-ԯ] }
  Identifier { identifierChar identifierContinue* }

  Number { $[0-9]+ ("." $[0-9]*)? }

  // Inside a SDBL fragment we still see BSL-style strings — used for literal
  // string values inside the query (e.g. WHERE field = "value").
  StringLit {
    '"' (![\n\r"] | '""')*
    ($[\n\r] $[ \t]* "|" (![\n\r"] | '""')*)*
    '"'
  }

  // Named punctuation and operators — same convention as bsl.grammar so
  // styleTags can use identifier-shaped path selectors and we stay aligned
  // with the upstream ANTLR token vocabulary.
  LParen        { "(" }
  RParen        { ")" }
  LBrace        { "{" }
  RBrace        { "}" }
  Comma         { "," }
  Colon         { ":" }
  Semicolon     { ";" }
  Dot           { "." }
  Hash          { "#" }
  Ampersand     { "&" }
  Plus          { "+" }
  Minus         { "-" }
  Mul           { "*" }
  Quotient      { "/" }
  Assign        { "=" }
  NotEqual      { "<>" }
  LessOrEqual   { "<=" }
  GreaterOrEqual { ">=" }
  Less          { "<" }
  Greater       { ">" }

  @precedence { LessOrEqual, NotEqual, Less }
  @precedence { GreaterOrEqual, Greater }
  @precedence { LineComment, Quotient }
  @precedence { Number, Dot }
}

// ---- External specialization: case-insensitive keyword matching ----
//
// SDBL keywords are dispatched through `sdblKeyword` in ./sdbl-tokens.ts,
// which lowercases the identifier text and looks it up in a static table
// covering both Russian and English spellings.
//
// Keywords are grouped into category-specific terms so styleTags can colour
// each group distinctly (statements vs operators vs aggregate functions vs
// type names vs metadata-object types vs virtual-table names).

@external specialize {Identifier} sdblKeyword from "./sdbl-tokens" {
  StmtKw,
  OpKw,
  FuncKw,
  TypeKw,
  MdoKw,
  FieldKw,
  BoolLit,
  NullLit,
  UndefinedLit
}

@detectDelim
